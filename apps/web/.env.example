# Copiar a apps/web/.env.local y completar. Nunca subir .env.local a Git.

# Supabase (local: ejecutar `pnpm db:start` y copiar los valores que imprime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOLO SERVIDOR. Se usa únicamente para invitar usuarios (administrador de plataforma).
SUPABASE_SECRET_KEY=

# SOLO SERVIDOR. Opcional: sin clave, el motor usa respuestas deterministas.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Origen de la extensión autorizada: chrome-extension://<id de 32 letras>
EXTENSION_ORIGIN=
